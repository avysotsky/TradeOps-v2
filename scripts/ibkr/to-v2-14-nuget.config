<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet traffic is permitted only during the explicitly opt-in REAL
     PostgreSQL acceptance restore step. No broker connections or credentials.
     Do not inherit machine/user or extra (possibly private) package feeds. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
