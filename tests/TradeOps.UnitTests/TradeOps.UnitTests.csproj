<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TradeOps.Api\TradeOps.Api.csproj" />
    <ProjectReference Include="..\..\apps\TradeOps.TerminalApi\TradeOps.TerminalApi.csproj" />
    <ProjectReference Include="..\..\src\TradeOps.Application\TradeOps.Application.csproj" />
    <ProjectReference Include="..\..\src\TradeOps.Connectors.Deribit\TradeOps.Connectors.Deribit.csproj" />
    <ProjectReference Include="..\..\src\TradeOps.Infrastructure\TradeOps.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\TradeOps.Worker\TradeOps.Worker.csproj" />
    <ProjectReference Include="..\..\tools\TradeOps.PublicResearchDemo\TradeOps.PublicResearchDemo.csproj" />
    <ProjectReference Include="..\..\tools\TradeOps.TranscriptResearchDemo\TradeOps.TranscriptResearchDemo.csproj" />
    <ProjectReference Include="..\..\tools\TradeOps.ProviderTranscriptResearchDemo\TradeOps.ProviderTranscriptResearchDemo.csproj" />
    <ProjectReference Include="..\..\tools\TradeOps.DeribitPrivateSessionProbe\TradeOps.DeribitPrivateSessionProbe.csproj" />
    <ProjectReference Include="..\..\tools\TradeOps.DeribitLiveInboxQualification\TradeOps.DeribitLiveInboxQualification.csproj" />
    <ProjectReference Include="..\..\tools\TradeOps.DeribitTestnetOrderQualification\TradeOps.DeribitTestnetOrderQualification.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Hash schema inputs, never a Git SHA or the entire application assembly. -->
    <EmbeddedResource Include="..\..\src\TradeOps.Infrastructure\Persistence\Migrations\*.cs;..\..\src\TradeOps.Infrastructure\Persistence\Configurations\*.cs;..\..\src\TradeOps.Infrastructure\Persistence\TradeOpsDbContext.cs"
                      LogicalName="TradeOps.TestSchema.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\scripts\testing\postgres-test-init.sql"
                      LogicalName="TradeOps.TestSchema.postgres-test-init.sql" />
  </ItemGroup>
</Project>
